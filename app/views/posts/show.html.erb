<div class="post">
    <div class="post-header">
        <% if @post.cover_image.attached? %>
            <%= image_tag @post.cover_image, class: "header-pic" %>
        <% end %>
        <p class="post-title">
            <%= @post.title %>
        </p>
        <p class="post-date">
            <%= @post.posted_at.strftime("%B %d, %Y") %>
        </p>
    </div>
    <div class="post-content">
        <%= @post.content %>
    </div>
    <br/>
    <div class="post-actions">
        <%= link_to "Edit", edit_post_path(@post), class: "btn btn-primary" if user_signed_in? %> 
        <% if user_signed_in? %>
        | 
        <% end %>
        <%= link_to "Back to Posts", posts_path, class: "btn btn-secondary" %>
    </div>
</div>