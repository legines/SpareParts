<div class="posts">
    <% @posts.each do |post| %>
        <div class="post">
            <h2><%= post.title %></h2>
            <p>hi</p>
            <p><em>Posted on <%= post.created_at.strftime("%B %d, %Y") %></em></p>
            <%= post.content %>
            
            <%= link_to "...more", post_path(post) %>
        </div>
    <% end %>
</div>