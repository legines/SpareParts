<div class="posts">
    <% @posts.each do |post| %>
        <div class="post">
            <div class="post-header">
                <% if post.cover_image.attached? %>
                    <%= image_tag post.cover_image, class: "header-pic" %>
                <% end %>
                <p class="post-title">
                    <%= post.title %>
                </p>
                <p class="post-date">
                    <%= post.posted_at.strftime("%B %d, %Y") %>
                </p>
            </div>
            <div class="post-content">
                <%= post.content %>
            </div>
            <div class="post-actions">
                <%= link_to "...more", post_path(post) %>
            </div>
        </div>
    <% end %>
</div>

