<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Spare Parts" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="<%= asset_path('favicon.ico') %>" type="image/x-icon">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <div class="main">
      <div class="main-header" data-controller="image-carousel" data-image-carousel-images="<%= ['SpareParts-black-gold.svg', 'SpareParts-black.svg', 'SpareParts-boulder-grey-pearl.svg', 'SpareParts-bright-white.svg', 'SpareParts-gold.svg', 'SpareParts-off-white.svg', 'SpareParts-purple.svg', 'SpareParts-white-text-only.svg'].map { |img| image_path(img) }.to_json %>">
        <%= image_tag "SpareParts-black-gold.svg", alt: "Logo", id: "Back_to_top", data: { "image-carousel-target": "image" } %>
      </div>
      <div class="main-content">
        <%= yield %>
      </div>
      <div class="bottom-bar">
        <% if user_signed_in? %>
          <%= link_to "New Post", new_post_path, class: "btn btn-primary" %> |
          <%= link_to "Logout", destroy_user_session_path, method: :delete, data: { turbo_method: :delete } %>
        <% end %>
      </div>
    </div>

    <%# lightbox modal %>
    <div class="lightbox-modal" data-controller="lightbox" data-action="click->lightbox#close">
      <img class="lightbox-image" data-lightbox-target="image" src="" alt="Full size image">
    </div>

  </body>
</html>
